# Copia este archivo a .env.local y ajusta los valores.
# Solo valores públicos: todo lo que empieza por VITE_ se incrusta en el bundle del navegador.
# NUNCA pongas aquí claves secretas (Stripe sk_..., whsec_..., Gemini, contraseñas de BD, etc.).

# true = demo sin backend, con los datos de ejemplo de src/demo/data.json (las URLs de abajo no se usan)
VITE_DEMO_MODE=false

# API Java / Spring Boot
VITE_API_URL=http://localhost:8080
# Microservicio de pagos (Flask + Stripe)
VITE_PAYMENTS_API_URL=http://localhost:5000
# Microservicio de recomendaciones (FastAPI + Gemini)
VITE_RECOMMENDATIONS_API_URL=http://localhost:8000
